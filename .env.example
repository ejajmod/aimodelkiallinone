# Optional protection for the public launcher endpoint. Open the UI with
# https://POD_ID-3000.proxy.runpod.net/?token=YOUR_TOKEN on first use.
RUNPOD_LAUNCHER_TOKEN=

# Central AIMODELKI API used by the optional Instant Models feature.
INSTANT_MODELS_API_URL=https://app.aimodelki.pl/api/v1/instant-models
INSTANT_MODELS_DISK_RESERVE_GB=5
INSTANT_MODELS_STATE_DIR=/workspace/.instant-models
INSTANT_MODELS_DOWNLOAD_HOSTS=.r2.cloudflarestorage.com

# Model downloads. "auto" uses aria2c when it is installed and falls back to the
# built-in Python downloader; "python" forces the built-in downloader.
AIMODELKI_DOWNLOADER=auto
# Files downloaded at the same time (1-8) and aria2c connections per file (1-16).
AIMODELKI_DOWNLOAD_PARALLEL_FILES=4
AIMODELKI_DOWNLOAD_CONNECTIONS_PER_FILE=16
# Built-in Python downloader only: HTTP Range streams per R2 file and segment size.
INSTANT_MODELS_DOWNLOAD_CONNECTIONS=64
INSTANT_MODELS_DOWNLOAD_SEGMENT_MB=64

# Pinned custom-node archives. A node is fetched from here only when the catalog lists
# its archive_sha256; otherwise the pinned commit is fetched from GitHub.
AIMODELKI_NODE_ARCHIVE_BASE_URL=https://pub-746aa51431cf4b7eac8a9cf5e44fbf58.r2.dev/custom-nodes

# Optional catalog override. Docker and the local launcher already have safe defaults.
# LAUNCHER_CATALOG_PATH=C:/absolute/path/to/catalog.json
LAUNCHER_CATALOG_URL=

# Optional token for a custom, private catalog that needs Hugging Face access.
HF_TOKEN=

# Optional, explicit startup update from a trusted GitHub repository.
LAUNCHER_UPDATE_ENABLED=0
LAUNCHER_UPDATE_REPO=
LAUNCHER_UPDATE_REF=main

# Base-image paths are supplied by Docker Compose. Uncomment only for a custom setup.
# COMFYUI_ROOT=C:/absolute/path/to/ComfyUI
# LAUNCHER_STATE_DIR=C:/absolute/path/to/launcher-state
